# Optional LLM-based classifier. If omitted, deterministic fallback rules are used.
# For Google's OpenAI-compatible Gemini endpoint, a typical base URL is:
# https://generativelanguage.googleapis.com/v1beta/openai
ROUTER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ROUTER_LLM_API_KEY=replace_with_your_api_key
ROUTER_LLM_MODEL=gemini-3.1-flash-lite
ROUTER_LLM_TIMEOUT_SECONDS=8

# Optional path override
ROUTER_CONFIG=config/models.yaml
